CONVOLOGIX_DATA_DIR=/app/data
CONVOLOGIX_FACE_DETECTOR_MODEL=/app/models/face_detection_yunet_2023mar.onnx
CONVOLOGIX_FACE_RECOGNITION_MODEL=/app/models/face_recognition_sface_2021dec.onnx
CONVOLOGIX_FACE_MATCH_THRESHOLD=0.62
CONVOLOGIX_AUTH_ENABLED=true
CONVOLOGIX_AUTH_SECRET_KEY=replace-with-a-long-random-secret
CONVOLOGIX_AUTH_TOKEN_MINUTES=720
CONVOLOGIX_BOOTSTRAP_ADMIN_EMAIL=
CONVOLOGIX_BOOTSTRAP_ADMIN_PASSWORD=
CONVOLOGIX_BOOTSTRAP_ADMIN_NAME=
CONVOLOGIX_SMOKE_EMAIL=
CONVOLOGIX_SMOKE_PASSWORD=
CONVOLOGIX_SMOKE_CREATE_ADMIN=false
CONVOLOGIX_BETA_EMAIL=
CONVOLOGIX_BETA_PASSWORD=
CONVOLOGIX_BETA_CREATE_ADMIN=false
CONVOLOGIX_ASR_MODEL=small.en
CONVOLOGIX_ASR_DEVICE=cpu
CONVOLOGIX_ASR_COMPUTE_TYPE=int8
CONVOLOGIX_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
CONVOLOGIX_INSTALL_DIARIZATION=false
HUGGINGFACE_TOKEN=
CONVOLOGIX_ATTENDANCE_SAMPLE_INTERVAL_SECONDS=20
CONVOLOGIX_ATTENDANCE_MAX_FRAMES=30
CONVOLOGIX_SMTP_HOST=
CONVOLOGIX_SMTP_PORT=587
CONVOLOGIX_SMTP_USERNAME=
CONVOLOGIX_SMTP_PASSWORD=
CONVOLOGIX_SMTP_FROM_EMAIL=
CONVOLOGIX_SMTP_USE_TLS=true
CONVOLOGIX_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://127.0.0.1:5173
